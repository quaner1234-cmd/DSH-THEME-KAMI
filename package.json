    "docs",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "skin",
    "kami",
    "paper",
    "editorial",
    "serif",
    "parchment",
    "ink-blue",
    "light",
    "dark"
  ],
  "license": "MIT",
  "author": "DSH-THEME-KAMI contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quaner1234-cmd/DSH-THEME-KAMI.git"
  },
